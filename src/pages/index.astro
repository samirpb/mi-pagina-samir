<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Para mi cielo</title>
    <style>
      body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        background: white;
        font-family: sans-serif;
        text-align: center;
      }
      h1 {
        font-size: 50px;
        font-weight: bold;
      }
      .corazon {
        font-size: 120px;
        margin-top: 20px;
        animation: latido 1.2s infinite;
        cursor: pointer;
      }
      @keyframes latido {
        0% { transform: scale(1); }
        50% { transform: scale(1.3); }
        100% { transform: scale(1); }
      }
      button {
        margin-top: 30px;
        padding: 15px 30px;
        font-size: 18px;
        border-radius: 30px;
        border: none;
        background: #ff4d6d;
        color: white;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <h1>Hola mi cielo te amo mucho 😘😘😘😘 🔥</h1>
    <div class="corazon" id="corazon">❤️</div>
    
    <button id="btnMusica">Toca aquí mi cielo 🎶</button>
    
    <audio id="audio" loop>
      <source src="/cancion.mp3" type="audio/mpeg" />
    </audio>

    <script>
      const btn = document.getElementById('btnMusica');
      const audio = document.getElementById('audio');
      const corazon = document.getElementById('corazon');
      
      function tocar() {
        audio.play();
        btn.style.display = 'none';
      }
      
      btn.addEventListener('click', tocar);
      corazon.addEventListener('click', tocar);
    </script>
  </body>
</html>