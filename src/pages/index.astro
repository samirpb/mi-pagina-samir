
---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<h1 style="text-align:center; margin-top:100px; font-family: sans-serif; font-size: 60px;">
		Hola soy Samir 🔥
	</h1>
	<p style="text-align:center; font-size: 80px; animation: latido 1s infinite;">
	❤️
	</p>
	<style>
@keyframes latido {
	0% { transform: scale(1); }
	50% { transform: scale(1.2); }
	100% { transform: scale(1); }
}
</style>
</Layout>