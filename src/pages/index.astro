<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Para mi cielo</title>
    <style>
      body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        background: white;
        font-family: sans-serif;
      }
      h1 {
        font-size: 50px;
        font-weight: bold;
        text-align: center;
      }
      .corazon {
        font-size: 120px;
        margin-top: 20px;
        animation: latido 1s infinite;
      }
      @keyframes latido {
        0% { transform: scale(1); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
      }
    </style>
  </head>
  <body>
    <h1>Hola mi cielo te amo mucho 😘😘😘😘 🔥</h1>
    <div class="corazon">❤️</div>
  </body>
</html>